{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Autonomous Tick",
  "description": "24/7 operating system tick \u2014 advances all in-progress projects one stage through the deterministic assembly line every 5 minutes, runs validation gates, and writes audit receipts.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "autonomous_tick",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "tick": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autonomousOrchestrator"
          },
          "x-base44": {
            "title": "Run autonomous tick",
            "description": "Advance projects one stage"
          }
        }
      },
      {
        "reconcile": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "reconciler"
          },
          "x-base44": {
            "title": "Reconcile state",
            "description": "Compare expected vs actual state, update receipts from evidence"
          }
        }
      },
      {
        "dispatch": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "capabilityDispatcher"
          },
          "then": "end",
          "x-base44": {
            "title": "Dispatch capabilities",
            "description": "Wire capabilities to executors and dispatch ready packets"
          }
        }
      }
    ]
  }
}