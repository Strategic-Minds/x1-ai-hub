{
  "name": "FactoryDefinition",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Factory name"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "icon": {
      "type": "string",
      "title": "Icon key",
      "default": "layers"
    },
    "locked": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "category"
  ]
}