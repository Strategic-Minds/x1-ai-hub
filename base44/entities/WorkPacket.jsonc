{
  "name": "WorkPacket",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "title": "Project (assembly line)"
    },
    "session_id": {
      "type": "string",
      "title": "Meta session"
    },
    "stage": {
      "type": "string",
      "title": "Lifecycle stage"
    },
    "title": {
      "type": "string",
      "title": "Packet title"
    },
    "objective": {
      "type": "string",
      "title": "Objective"
    },
    "phase": {
      "type": "string",
      "title": "Phase"
    },
    "generator": {
      "type": "string",
      "title": "Generator used"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "READY",
        "BLOCKED",
        "WAITING_DEPENDENCY",
        "WAITING_APPROVAL",
        "QUEUED",
        "RUNNING",
        "VALIDATING",
        "FAILED",
        "REPAIR_REQUIRED",
        "PASSED",
        "COMPLETE",
        "pending",
        "running",
        "passed",
        "failed",
        "blocked"
      ],
      "default": "DRAFT"
    },
    "action_class": {
      "type": "string",
      "enum": [
        "READ",
        "DRAFT",
        "BRANCH_WRITE",
        "PROTECTED"
      ],
      "default": "DRAFT"
    },
    "risk_class": {
      "type": "string",
      "enum": [
        "READ",
        "DRAFT",
        "BRANCH_WRITE",
        "PROTECTED"
      ],
      "default": "DRAFT"
    },
    "inputs": {
      "type": "string"
    },
    "outputs": {
      "type": "string"
    },
    "dependencies": {
      "type": "string",
      "title": "Comma-separated packet titles"
    },
    "acceptance_criteria": {
      "type": "string"
    },
    "validation_requirements": {
      "type": "string"
    },
    "allowed_actions": {
      "type": "string"
    },
    "forbidden_actions": {
      "type": "string"
    },
    "recommended_executor": {
      "type": "string"
    },
    "preferred_executor": {
      "type": "string"
    },
    "fallback_executor": {
      "type": "string"
    },
    "rollback_requirements": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ]
}