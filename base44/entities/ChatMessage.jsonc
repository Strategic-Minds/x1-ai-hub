{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "title": "Chat session"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ],
      "default": "user"
    },
    "content": {
      "type": "string",
      "title": "Message content"
    },
    "model": {
      "type": "string",
      "title": "Model used"
    }
  },
  "required": [
    "session_id",
    "role",
    "content"
  ]
}